{
  "name": "cloudpuls",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/a/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [ { "name": "APPS", "class_name": "AppStore" }, { "name": "SYNC", "class_name": "SyncStore" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["AppStore", "SyncStore"] } ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issues": { "enabled": true }
  }
}
